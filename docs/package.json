{
  "name": "@email-utils/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "npm ci --prefix typedoc --no-audit --no-fund",
    "api": "tsx typedoc/generate.mts",
    "build": "next build",
    "prebuild": "npm run api",
    "dev": "next dev",
    "predev": "npm run api",
    "start": "serve out",
    "lint:links": "tsx scripts/check-links.mts",
    "prelint:links": "npm run api",
    "types:check": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "@email-utils/classifier": "1.0.0-rc.5",
    "@email-utils/sanitizer": "1.0.0-rc.3",
    "@email-utils/validator-dns": "1.0.0-rc.2",
    "@email-utils/validator-syntax": "1.0.0-rc.4",
    "cn": "^0.4.0",
    "fumadocs-core": "16.15.17",
    "fumadocs-docgen": "3.1.1",
    "fumadocs-mdx": "15.4.5",
    "fumadocs-twoslash": "4.0.1",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.15.17",
    "lucide-react": "^1.47.0",
    "next": "16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "next-validate-link": "1.6.7",
    "postcss": "^8.5.28",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "tsx": "4.23.15",
    "typescript": "^7.0.2"
  }
